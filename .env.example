# =============================================================================
# ACIS environment configuration (EXAMPLE)
# -----------------------------------------------------------------------------
# Copy to `.env` and fill in real values for production use.
# NEVER commit a populated `.env`. Secrets belong here or in your secret
# manager only - never in source code or YAML config files.
#
# Every variable is prefixed with `ACIS_`. Nested settings use `__`.
# Example: ACIS_INTEGRATIONS__CANVA__MODE=live
# =============================================================================

# ---- Runtime ---------------------------------------------------------------
ACIS_ENV=development          # development | staging | production
ACIS_LOG__LEVEL=INFO          # DEBUG | INFO | WARNING | ERROR
ACIS_LOG__FORMAT=console      # console | json

# ---- Global integration mode ----------------------------------------------
# When "mock", every adapter runs against simulated backends and NO real
# credentials are required. Set to "live" only once credentials are in place.
# Per-integration overrides below take precedence over this global default.
ACIS_INTEGRATIONS__DEFAULT_MODE=mock

# ---- Canva Premium ---------------------------------------------------------
ACIS_INTEGRATIONS__CANVA__MODE=mock
ACIS_INTEGRATIONS__CANVA__API_KEY=
ACIS_INTEGRATIONS__CANVA__BRAND_KIT_ID=

# ---- Instagram Graph API ---------------------------------------------------
ACIS_INTEGRATIONS__INSTAGRAM__MODE=mock
ACIS_INTEGRATIONS__INSTAGRAM__ACCESS_TOKEN=
ACIS_INTEGRATIONS__INSTAGRAM__BUSINESS_ACCOUNT_ID=

# ---- TikTok API ------------------------------------------------------------
ACIS_INTEGRATIONS__TIKTOK__MODE=mock
ACIS_INTEGRATIONS__TIKTOK__CLIENT_KEY=
ACIS_INTEGRATIONS__TIKTOK__CLIENT_SECRET=
ACIS_INTEGRATIONS__TIKTOK__ACCESS_TOKEN=

# ---- OpenAI ----------------------------------------------------------------
ACIS_INTEGRATIONS__OPENAI__MODE=mock
ACIS_INTEGRATIONS__OPENAI__API_KEY=
ACIS_INTEGRATIONS__OPENAI__MODEL=gpt-4o

# ---- Trend sources ---------------------------------------------------------
ACIS_INTEGRATIONS__TRENDS__MODE=mock
ACIS_INTEGRATIONS__TRENDS__API_KEY=

# ---- Analytics -------------------------------------------------------------
ACIS_INTEGRATIONS__ANALYTICS__MODE=mock
ACIS_INTEGRATIONS__ANALYTICS__API_KEY=

# ---- Persistence -----------------------------------------------------------
ACIS_STORAGE__BACKEND=sqlite   # memory | sqlite
ACIS_STORAGE__SQLITE_PATH=var/acis.db

# ---- Quality gate ----------------------------------------------------------
ACIS_QUALITY__MIN_SCORE=0.75   # content below this score is never published
